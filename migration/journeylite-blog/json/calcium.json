  "bodyHtml": "<div class=\"entry-content\"><div class=\"wpb-content-wrapper\"><div class=\"vc_row wpb_row vc_row-fluid\"><div class=\"wpb_column vc_column_container vc_col-sm-12\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_single_image wpb_content_element vc_align_center wpb_content_element\">\n\t\t\n\t\t<figure class=\"wpb_wrapper vc_figure\">\n\t\t\t<div class=\"vc_single_image-wrapper vc_box_shadow_3d  vc_box_border_grey\"><img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"300\" src=\"https://journeylite.com/wp-content/smush-webp/2021/07/minerals-300x300.jpg.webp\" class=\"vc_single_image-img attachment-medium\" alt=\"minerals\" title=\"minerals\" srcset=\"https://journeylite.com/wp-content/smush-webp/2021/07/minerals-300x300.jpg.webp 300w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled-500x500.jpg.webp 500w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled-180x180.jpg.webp 180w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled-660x660.jpg.webp 660w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled.jpg.webp 1024w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-150x150.jpg.webp 150w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-768x768.jpg.webp 768w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-100x100.jpg.webp 100w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-50x50.jpg.webp 50w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\"></div>\n\t\t</figure>\n\t</div>\n\n\t<div class=\"wpb_text_column wpb_content_element\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<h2 style=\"text-align: center;\"><b>Calcium</b></h2>\n<p><span style=\"font-weight: 400;\">Function:&nbsp; </span> <span style=\"font-weight: 400;\">Builds bone and teeth, needed for muscle contraction/relaxation, blood clotting, and normal heart rhythm.</span></p>\n<p><span style=\"font-weight: 400;\">Deficie