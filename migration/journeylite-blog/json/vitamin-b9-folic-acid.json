  "bodyHtml": "<div class=\"entry-content\"><div class=\"wpb-content-wrapper\"><div class=\"vc_row wpb_row vc_row-fluid\"><div class=\"wpb_column vc_column_container vc_col-sm-12\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_single_image wpb_content_element vc_align_center wpb_content_element\">\n\t\t\n\t\t<figure class=\"wpb_wrapper vc_figure\">\n\t\t\t<div class=\"vc_single_image-wrapper vc_box_shadow_3d  vc_box_border_grey\"><img decoding=\"async\" width=\"300\" height=\"157\" src=\"https://journeylite.com/wp-content/smush-webp/2021/07/vitamins-300x157.jpg.webp\" class=\"vc_single_image-img attachment-medium\" alt=\"vitamins\" title=\"vitamins\" srcset=\"https://journeylite.com/wp-content/smush-webp/2021/07/vitamins-300x157.jpg.webp 300w, https://journeylite.com/wp-content/smush-webp/2021/07/vitamins-scaled-660x345.jpg.webp 660w, https://journeylite.com/wp-content/smush-webp/2021/07/vitamins-scaled.jpg.webp 1024w, https://journeylite.com/wp-content/smush-webp/2021/07/vitamins-768x401.jpg.webp 768w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" loading=\"lazy\"></div>\n\t\t</figure>\n\t</div>\n\n\t<div class=\"wpb_text_column wpb_content_element\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<h2 style=\"text-align: center;\"><b>Vitamin B-9 (Folic Acid)</b></h2>\n<p><span style=\"font-weight: 400;\">Function:&nbsp; </span> <span style=\"font-weight: 400;\">Part of blood cells, necessary for cell division, and important in increasing the number of blood cells.</span></p>\n<p><span style=\"font-weight: 400;\">Deficiency:</span> <span style=\"font-weight: 400;\">The symptoms of Folic Acid deficiency include:&nbsp; oral lesions, swollen tongue, and anemia</span></p>\n<p><span style=\"font-weight: 400;\">Toxicity:</span> <span style=\"font-weight: 400;\">Large doses of Folic Acid may damage the kidneys and may mask a B-12 deficiency.</span></p>\n<p>&nbsp;</p>\n<h3><b>Recommended Daily intake of Folic Acid is:</b></h3>\n<h4><b>MEN AND WO