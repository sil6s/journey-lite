  "bodyHtml": "<div class=\"entry-content\"><div class=\"wpb-content-wrapper\"><div class=\"vc_row wpb_row vc_row-fluid\"><div class=\"wpb_column vc_column_container vc_col-sm-12\"><div class=\"vc_column-inner\"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_single_image wpb_content_element vc_align_center wpb_content_element\">\n\t\t\n\t\t<figure class=\"wpb_wrapper vc_figure\">\n\t\t\t<div class=\"vc_single_image-wrapper vc_box_shadow_3d  vc_box_border_grey\"><img decoding=\"async\" width=\"300\" height=\"300\" src=\"https://journeylite.com/wp-content/smush-webp/2021/07/minerals-300x300.jpg.webp\" class=\"vc_single_image-img attachment-medium\" alt=\"minerals\" title=\"minerals\" srcset=\"https://journeylite.com/wp-content/smush-webp/2021/07/minerals-300x300.jpg.webp 300w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled-500x500.jpg.webp 500w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled-180x180.jpg.webp 180w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled-660x660.jpg.webp 660w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-scaled.jpg.webp 1024w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-150x150.jpg.webp 150w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-768x768.jpg.webp 768w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-100x100.jpg.webp 100w, https://journeylite.com/wp-content/smush-webp/2021/07/minerals-50x50.jpg.webp 50w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" loading=\"lazy\"></div>\n\t\t</figure>\n\t</div>\n\n\t<div class=\"wpb_text_column wpb_content_element\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<h2 style=\"text-align: center;\"><b>Iron</b></h2>\n<p><span style=\"font-weight: 400;\">Function:&nbsp; </span> <span style=\"font-weight: 400;\">Carrier of oxygen and helps prevent anemia.</span></p>\n<p><span style=\"font-weight: 400;\">Deficiency:</span> <span style=\"font-weight: 400;\">Anemia, fatigue, sore mouth/tongue, and weight loss.</span></p>\n<p><span style=\"font-weight: 400;\">Toxicity:</span> <span style=\"font-weight: 400;\">Severe vomiting, diarrhea, abdominal pain</span></p>\n<p>&nbsp;</p>\n<h3><b>Recommended Daily intake of Iron is:</b></h3>\n<h4><b>MEN AGE 19-70 = 8 MG/D</b></h4>\n<p><b>WOMEN:AGE 19-50 = 18 MG/D</b></p>\n<p><b>AGE 50+ = 8 MG/D</b></p>\n<p>&nbsp;</p>\n<table>\n<tbody>\n<tr>\n<td>\n<h2><b>FOOD SOURCES</b></h2>\n</td>\n<td>\n<h2><b>AMOUNT</b></h2>\n</td>\n<td><b># of MG</b></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>\n<h2><b>DAIRY PRODUCTS</b></h2>\n</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Eggs</span></td>\n<td><span style=\"font-weight: 400;\">2 each</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>\n<h2><b>PROTEIN FOODS</b></h2>\n</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Clams, raw</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">12</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Liver, beef</span></td>\n<td><span style=\"font-weight: 400;\">2 ounces</span></td>\n<td><span style=\"font-weight: 400;\">5</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Sardines, canned</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">5</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Beans, lima, dry/cooked</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Beef, variety</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Pork, variety (not ham)</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Turkey, variety</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Dry beans, split peas</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Soybeans, boiled</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Black-eyed peas, boiled</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Chicken, variety (no skins)</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Garbanzos beans, canned</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Peanut Butter</span></td>\n<td><span style=\"font-weight: 400;\">1 Tablespoon</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table>\n<tbody>\n<tr>\n<td>\n<h2><b>BREADS/CEREALS</b></h2>\n</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Bulgar flour</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">21</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Wheat bran, crude</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">15</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Bran flakes</span></td>\n<td><span style=\"font-weight: 400;\">¾ cup</span></td>\n<td><span style=\"font-weight: 400;\">8</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Corn flakes, fortified</span></td>\n<td><span style=\"font-weight: 400;\">¾ cup</span></td>\n<td><span style=\"font-weight: 400;\">8</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Cream of wheat</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">8</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Malt-o-meal</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">8</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">All Bran</span></td>\n<td><span style=\"font-weight: 400;\">1/3 cup</span></td>\n<td><span style=\"font-weight: 400;\">5</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Waffle</span></td>\n<td><span style=\"font-weight: 400;\">1 each</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Corn tortilla</span></td>\n<td><span style=\"font-weight: 400;\">1 each</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Corn meal, enriched</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">3</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Bread, white</span></td>\n<td><span style=\"font-weight: 400;\">1 slice</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Rice, white, enriched raw</span></td>\n<td><span style=\"font-weight: 400;\">1 cup</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Rice, brown, cooked</span></td>\n<td><span style=\"font-weight: 400;\">1 cup</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Oatmeal, cooked</span></td>\n<td><span style=\"font-weight: 400;\">¾ cup</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Enriched bread</span></td>\n<td><span style=\"font-weight: 400;\">1 slice</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Whole grain bread</span></td>\n<td><span style=\"font-weight: 400;\">1 slice</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table>\n<tbody>\n<tr>\n<td>\n<h2><b>FOOD SOURCES</b></h2>\n</td>\n<td>\n<h2><b>AMOUNT</b></h2>\n</td>\n<td><b># of MG</b></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>\n<h2><b>FRUITS</b></h2>\n</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Peaches, dried</span></td>\n<td><span style=\"font-weight: 400;\">3 ounces</span></td>\n<td><span style=\"font-weight: 400;\">4</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Prune juice</span></td>\n<td><span style=\"font-weight: 400;\">½ cup</span></td>\n<td><span style=\"font-weight: 400;\">2</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Apricots</span></td>\n<td><span style=\"font-weight: 400;\">2 each</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n<tr>\n<td><span style=\"font-weight: 400;\">Prunes, dried</span></td>\n<td><span style=\"font-weight: 400;\">2 each</span></td>\n<td><span style=\"font-weight: 400;\">1</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table>\n<tbody>\n<tr>\n<td>\n<h2><b>FOOD SOURCES</b></h2>\n</td>\n<td>\n<h2><b>AMOUNT</b></h2>\n</td>\n<td><b># of MG</b></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>\n<h2><b>VEGETABLES</b></h2>\n</td>\n<td></td>\n<td></