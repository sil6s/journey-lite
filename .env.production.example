NEXT_PUBLIC_SUPABASE_URL=https://qsuwxvnqqyowohpamhie.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key from Supabase dashboard -> Project Settings -> API>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-key or same publishable key if needed for compatibility>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key from Supabase dashboard â†’ Settings â†’ API>
