# â”€â”€â”€ Sanity (blog only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_SANITY_PROJECT_ID=44pkofuy
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-05
SANITY_API_READ_TOKEN=<read-token>
SANITY_API_WRITE_TOKEN=<write-token>

# â”€â”€â”€ Email / SMTP (use Brevo SMTP relay) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# In Brevo: Settings â†’ Senders & IP â†’ SMTP & API â†’ Generate SMTP key
# Use the login email as SMTP_USER and the generated SMTP key as SMTP_PASS
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-login-email>
SMTP_PASS=<your-brevo-smtp-key>

# From address shown on all outgoing emails (must be a verified Brevo sender)
CONTACT_FROM_EMAIL=JourneyLite <info@journeylite.com>
# Where staff notification emails are sent for the main contact/appointment form
CONTACT_NOTIFY_EMAIL=info@journeylite.com

# Cloudflare Turnstile (managed widget) for public contact forms
# Site key is browser-safe. Secret key must be set only in Vercel/server env vars.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADdxJ_5UZhIunW9c
TURNSTILE_SECRET_KEY=<cloudflare-turnstile-secret-key>
TURNSTILE_ENFORCEMENT=required

# --- AI Translation (Gemini -- used for Sanity CMS content only) ---
# Get key from: https://aistudio.google.com/apikey
# Server-side only -- NEVER exposed to the browser.
# Model: gemini-flash-lite-latest (cheapest Gemini tier).
# Calls go through Gemini's OpenAI-compatible endpoint; json_object response_format
# guarantees valid JSON output.
GEMINI_API_KEY=<your-gemini-api-key>

# â”€â”€â”€ Sanity webhook secret (translation cache invalidation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate: openssl rand -hex 32
# Set the same value in: Sanity Dashboard â†’ API â†’ Webhooks â†’ your webhook â†’ Secret
# The webhook POSTs to /api/sanity-webhook when a document is published/updated.
SANITY_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# â”€â”€â”€ Brevo (contact list management) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# In Brevo: Settings â†’ API Keys â†’ Generate new key
# Used to add contacts to Brevo lists when a form includes a brevoListId
BREVO_API_KEY=<your-brevo-api-key>
