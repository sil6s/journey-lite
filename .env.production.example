# ─── Open edX / Tutor Production ──────────────────────────────────────────────
# After running `tutor local launch` on your production server:
NEXT_PUBLIC_OPENEDX_LMS_URL=https://learn.journeylite.com
NEXT_PUBLIC_OPENEDX_CMS_URL=https://studio.journeylite.com

# OAuth2 — create via Django Admin → OAuth2 → Applications
OPENEDX_CLIENT_ID=journeylite-nextjs
OPENEDX_CLIENT_SECRET=<your-secret-here>

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://terbeqsmulzhfntskjjj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key from Supabase dashboard → Settings → API>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key from Supabase dashboard → Settings → API>

# ─── Supabase Auth (Google OAuth) ─────────────────────────────────────────────
# In Supabase dashboard: Authentication → Providers → Google
# Add your Google OAuth client ID and secret there (NOT in .env).
# Set the redirect URL in Google Cloud Console to:
#   https://terbeqsmulzhfntskjjj.supabase.co/auth/v1/callback
# The app callback URL (set in Supabase "Redirect URLs" allowlist):
#   https://journeylite.com/api/auth/callback
#   http://localhost:3000/api/auth/callback   (for dev)

# ─── Sanity (blog only) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=44pkofuy
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-05
SANITY_API_READ_TOKEN=<read-token>
SANITY_API_WRITE_TOKEN=<write-token>

# ─── Email / SMTP (use Brevo SMTP relay) ───────────────────────────────────────
# In Brevo: Settings → Senders & IP → SMTP & API → Generate SMTP key
# Use the login email as SMTP_USER and the generated SMTP key as SMTP_PASS
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-login-email>
SMTP_PASS=<your-brevo-smtp-key>

# From address shown on all outgoing emails (must be a verified Brevo sender)
CONTACT_FROM_EMAIL=JourneyLite <info@journeylite.com>
# Where staff notification emails are sent for the main contact/appointment form
CONTACT_NOTIFY_EMAIL=info@journeylite.com

# ─── AI Translation (DeepSeek — used for Sanity CMS content only) ──────────────
# Get key from: https://platform.deepseek.com/api_keys
# Server-side only — NEVER exposed to the browser.
# Model: deepseek-chat (DeepSeek-V3). ~10x cheaper than Claude Haiku.
# json_object response_format guarantees valid JSON output.
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# ─── Sanity webhook secret (translation cache invalidation) ────────────────────
# Generate: openssl rand -hex 32
# Set the same value in: Sanity Dashboard → API → Webhooks → your webhook → Secret
# The webhook POSTs to /api/sanity-webhook when a document is published/updated.
SANITY_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# ─── Brevo (contact list management) ───────────────────────────────────────────
# In Brevo: Settings → API Keys → Generate new key
# Used to add contacts to Brevo lists when a form includes a brevoListId
BREVO_API_KEY=<your-brevo-api-key>
